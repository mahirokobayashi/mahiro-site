---
import FilingsHero from '../components/FilingsHero.astro';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>mahiro kobayashi — visual design</title>
    <meta name="description" content="小林磨央 / mahiro。グラフィック、プロダクト、WEB のビジュアルデザイン。東京。" />
  </head>
  <body>
    <FilingsHero
      name="mahiro kobayashi"
      meta="visual design — tokyo"
      count={4200}
      grain={0.9}
      speed={0.6}
      range={520}
      mode="edge"
    />
  </body>
</html>

<style is:global>
  :root {
    --n100: #f0f5fa;
    --n600: #696978;
    --n800: #232332;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--n100);
    color: var(--n800);
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Noto Sans JP", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a:focus-visible, [data-hit]:focus-visible {
    outline: 2px solid var(--n800);
    outline-offset: 3px;
  }
</style>
